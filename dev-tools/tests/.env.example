# Variables requeridas para correr cazabugs_200_wp.sh y bugs_focused.sh
#
# Uso:
#   cp dev-tools/tests/.env.example dev-tools/tests/.env
#   # Edita .env con tus valores locales
#   set -a && source dev-tools/tests/.env && set +a
#   bash dev-tools/tests/cazabugs_200_wp.sh
#
# El fichero .env real está gitignored, no lo commitees.

# ── Endpoint dev e2e_api.php ──
# Es la URL absoluta al fichero PHP del plugin que actúa como puerta para
# manipular el WP en tests. Solo responde si TPV_SYNC_E2E_ENABLED=true en
# wp-config.php Y el header X-Test-Secret coincide con la opción de WP.
TPV_SYNC_E2E_BASE="https://tu-dev-wp.local/wp-content/plugins/woocommerce_conector/tests/e2e_api.php"

# URL completa de la API del TPV (lo que ha guardado el plugin como
# tpv_sync_api_url tras el wizard). Usado por el test A01 para validar
# que el plugin está apuntando al TPV correcto.
TPV_SYNC_EXPECTED_API_URL="https://tu-tpv.local/api/v1"

# Secret X-Test-Secret. Lo encuentras en:
#   wp option get tpv_sync_e2e_trigger_secret
# La primera vez que el endpoint se invoca se autogenera.
TPV_SYNC_E2E_SECRET="copia_aqui_el_valor_real"

# Receptor de webhooks (ruta /tpv-webhook/ del WP)
TPV_SYNC_WEBHOOK_URL="https://tu-dev-wp.local/tpv-webhook/"

# Path absoluto al WordPress local (con barra final)
TPV_SYNC_WP_ABSPATH="/var/www/html/wp/public_html/"

# Credenciales MySQL para verificar inserts/updates
TPV_SYNC_DB_USER="root"
TPV_SYNC_DB_PASS="cambia_esto"
TPV_SYNC_DB_NAME="wordpress_db"

# Opcional: fallback de webhook secret si la opción tpv_sync_webhook_secret
# está vacía (caso raro tras reset). Normalmente déjalo vacío.
# TPV_SYNC_WEBHOOK_SECRET_FALLBACK=""
