<?xml version="1.0"?>
<ruleset name="woocommerce-conector">
    <description>Coding standards for the WooCommerce Conector plugin.</description>

    <!-- Paths to scan -->
    <file>woocommerce-conector.php</file>
    <file>includes</file>

    <!-- Exclude third-party and generated code -->
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>dev-tools/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>languages/*</exclude-pattern>
    <exclude-pattern>docs/*</exclude-pattern>

    <!-- Arguments -->
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/> <!-- show sources and progress -->

    <!-- Base ruleset: WordPress-Extra (core + docs + extra), minus some rigidities -->
    <rule ref="WordPress-Extra">
        <!-- El plugin ya es PSR-like en naming; aplicar WP sólo donde aporte -->
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <!-- Strict types incompatible con "Squiz.Commenting" level exigente -->
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
        <!-- Permitir short array syntax (ya se usa en todo el plugin) -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- Text domain consistency -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="tpv-sync"/>
        </properties>
    </rule>

    <!-- Minimum WP version -->
    <config name="minimum_supported_wp_version" value="6.0"/>

    <!-- PHP 8.0+ -->
    <config name="testVersion" value="8.0-"/>
</ruleset>
