{
    "name": "catinfog/woocommerce-conector",
    "description": "Conector bidireccional entre WooCommerce y el TPV Catinfog (productos, stock, pedidos, devoluciones).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": ["woocommerce", "wordpress", "tpv", "pos", "sync", "catinfog"],
    "homepage": "https://catinfog.com",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/woocommerce-stubs": "^10.7",
        "php-stubs/wordpress-stubs": "^6.6",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "infection/infection": "^0.29"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml",
        "lint:fix": "phpcbf --standard=phpcs.xml",
        "analyze": "phpstan analyze -c phpstan.neon",
        "test": "phpunit",
        "test:suite": "bash dev-tools/tests/cazabugs_200_wp.sh",
        "test:focused": "bash dev-tools/tests/bugs_focused.sh",
        "mutation": "infection --threads=4 --min-msi=70 --min-covered-msi=80"
    }
}
