{
    // Mutation testing — verifica que los tests detectan cambios accidentales
    // (mutantes) en el código. Un MSI (Mutation Score Indicator) >=70 indica
    // que los tests cazan la mayoría de mutaciones.
    "source": {
        "directories": [
            "../woocommerce-conector/includes"
        ],
        "excludes": [
            // class-api-client hace wp_remote_* y no tiene tests aislados aún
            "class-api-client.php",
            // class-admin es UI + AJAX — requiere browser/WP para testear
            "class-admin.php",
            // class-cli es WP-CLI commands
            "class-cli.php",
            // class-notifications manda emails/slack — requiere WP_Mail
            "class-notifications.php",
            // Los sync buzzworthy requieren mocks profundos de WC
            "class-product-sync.php",
            "class-order-sync.php"
        ]
    },
    "timeout": 10,
    "logs": {
        "text": ".infection/infection.log",
        "html": ".infection/infection.html",
        "summary": ".infection/summary.log"
    },
    "tmpDir": ".infection/tmp",
    "mutators": {
        "@default": true,
        "global-ignore": [
            // Ignorar mutaciones en constructores vacíos y getters triviales
            "*::__construct"
        ]
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=unit"
}
