includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    phpVersion: 80100

    paths:
        - woocommerce-conector.php
        - includes

    excludePaths:
        analyseAndScan:
            - tests/*
            - .memoria_wp/*
            - vendor/*
            - languages/*

    bootstrapFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php

    ignoreErrors:
        # WC API devuelve arrays dinámicos que phpstan no puede inferir
        - '#Parameter \#1 \$post_id of function get_post_meta#'
        - '#Cannot access offset [a-zA-Z_\x7f-\xff][a-zA-Z0-9_\x7f-\xff]*.*on mixed#'
        # libsodium constants pueden no estar visibles según entorno
        - '#Constant SODIUM_CRYPTO_SECRETBOX_[A-Z]+ not found#'
